---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, links, projects, stack, focus } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<BaseLayout>
  <section class="hero" id="top">
    <canvas class="hero-net" id="heroNet" aria-hidden="true"></canvas>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner wrap">
      <span class="hero-kicker"><span class="gdot"></span>{site.location} · SDE2 · open to good problems</span>
      <h1 class="name gradient-text">{site.name}</h1>
      <p class="hero-role">{site.role}</p>
      <p class="hero-lede"><span class="hero-tag">{site.tagline}</span> {site.lede}</p>
      <div class="hero-cta">
        <a class="btn primary" href={links.github}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.36 1.11 2.94.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
          GitHub
        </a>
        <a class="btn" href={links.linkedin}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          LinkedIn
        </a>
        <a class="btn" href={links.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
          Email
        </a>
      </div>
    </div>
  </section>

  <main class="wrap">

    <section class="snapshot" id="about">
      <div class="bento">
        <div class="cell cell-now">
          <div class="clabel">Currently</div>
          <div class="cbig">Backend at <b>{site.now.where}</b></div>
          <div class="csub">{site.now.what}</div>
        </div>
        <div class="cell cell-xp">
          <div class="clabel">Experience</div>
          <div class="xpnum">3.5<span style="font-size:.55em">+</span></div>
          <div class="xpsub">years shipping production backends</div>
        </div>
        <div class="cell cell-focus">
          <div class="clabel">Focus</div>
          <div class="focus-list">{focus.map((f) => <span>{f}</span>)}</div>
        </div>
        <div class="cell cell-stack">
          <div class="clabel">Stack</div>
          <div class="stack">{stack.map((s) => <span class={`chip${s.key ? ' k' : ''}`}>{s.name}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="block" id="writing">
      <div class="shead"><h2>Writing</h2><span class="idx">{posts.length} post{posts.length === 1 ? '' : 's'}</span></div>
      {posts.map((post) => (
        <a class="post" href={`/blog/${post.id}`}>
          <div class="pmeta"><span>{fmt(post.data.date)}</span><span class="rt">{post.data.readTime}</span></div>
          <div class="ptitle">{post.data.title}</div>
          <p class="pdek">{post.data.dek}</p>
          <div class="ptags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </section>

    <section class="block" id="projects">
      <div class="shead"><h2>Projects</h2><span class="idx">low-level design</span></div>
      <div class="projgrid">
        {projects.map((p) => (
          <div class="projcard">
            <span class="pname">{p.name}</span>
            <p class="pdesc">{p.desc}</p>
            <a class="plink" href={p.url}>view source ↗</a>
          </div>
        ))}
      </div>
    </section>

    <footer>
      <div class="flinks">
        <a href={links.github}>GitHub</a>
        <a href={links.linkedin}>LinkedIn</a>
        <a href={links.email}>Email</a>
        <a href={links.rss}>RSS</a>
      </div>
      <p class="fnote">&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>

  </main>

  <script is:inline>
    (function () {
      var c = document.getElementById('heroNet');
      if (!c) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ctx = c.getContext('2d');
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var W, H, nodes, raf;
      function size() {
        var r = c.parentElement.getBoundingClientRect();
        W = r.width; H = r.height;
        c.width = W * dpr; c.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function build() {
        var count = Math.min(64, Math.round(W / 22));
        nodes = [];
        for (var i = 0; i < count; i++) {
          nodes.push({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.25,
            vy: (Math.random() - 0.5) * 0.25
          });
        }
      }
      function frame() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < nodes.length; i++) {
          var n = nodes[i];
          n.x += n.vx; n.y += n.vy;
          if (n.x < 0 || n.x > W) n.vx *= -1;
          if (n.y < 0 || n.y > H) n.vy *= -1;
          for (var j = i + 1; j < nodes.length; j++) {
            var m = nodes[j], dx = n.x - m.x, dy = n.y - m.y;
            var d = Math.sqrt(dx * dx + dy * dy);
            if (d < 130) {
              var a = (1 - d / 130) * 0.5;
              var t = m.x / W;
              ctx.strokeStyle = 'rgba(' + Math.round(124 + t * (34 - 124)) + ',' + Math.round(108 + t * (211 - 108)) + ',' + Math.round(246 + t * (238 - 246)) + ',' + a + ')';
              ctx.lineWidth = 0.6;
              ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(m.x, m.y); ctx.stroke();
            }
          }
        }
        for (var k = 0; k < nodes.length; k++) {
          ctx.fillStyle = 'rgba(160,150,250,.75)';
          ctx.beginPath(); ctx.arc(nodes[k].x, nodes[k].y, 1.6, 0, Math.PI * 2); ctx.fill();
        }
        raf = requestAnimationFrame(frame);
      }
      function start() {
        size(); build();
        if (reduce) { frame(); cancelAnimationFrame(raf); return; }
        cancelAnimationFrame(raf); frame();
      }
      start();
      var to;
      window.addEventListener('resize', function () {
        clearTimeout(to); to = setTimeout(start, 200);
      });
    })();
  </script>
</BaseLayout>
